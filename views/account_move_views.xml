<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_fsm_credit_return" model="ir.ui.view">
        <field name="name">account.move.form.fsm.credit.return</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <widget
                    name="signature"
                    string="Sign"
                    highlight="1"
                    invisible="is_signed or move_type != 'out_refund'"
                    full_name="partner_id"
                />
            </xpath>
            <xpath expr="//sheet" position="before">
                <field name="reza_fsm_credit_unfinished" invisible="1"/>
                <div
                    class="alert alert-warning mb-0"
                    role="alert"
                    invisible="not reza_fsm_credit_unfinished"
                >
                    This draft belongs to an <b>unfinished field service credit</b>.
                    The rep is still adding products. The rep confirms it from the
                    visit, which posts this same credit note.
                    Only members of <b>Post unfinished rep credits</b> can post it
                    here. A post from here does <b>NOT</b> return the stock: the
                    draft has no return events.
                </div>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field
                    name="reza_fsm_task_id"
                    readonly="1"
                    invisible="not reza_fsm_task_id"
                />
                <field
                    name="is_signed"
                    invisible="1"
                />
                <field
                    name="reza_fsm_customer_signed_by"
                    readonly="1"
                    invisible="not reza_fsm_customer_signature"
                />
                <field
                    name="reza_fsm_customer_signed_on"
                    readonly="1"
                    invisible="not reza_fsm_customer_signature"
                />
                <field
                    name="reza_fsm_customer_signature"
                    widget="image"
                    readonly="1"
                    invisible="not reza_fsm_customer_signature"
                />
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='quantity']" position="after">
                <field name="reza_fsm_credit_return_outcome" optional="show"/>
                <field name="reza_fsm_credit_return_location_id" optional="show"/>
                <field name="reza_fsm_credit_reason_ids" widget="many2many_tags" optional="hide"/>
                <field name="reza_fsm_scrap_reason_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
