<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reza_fsm_credit_return_wizard_form" model="ir.ui.view">
        <field name="name">reza.fsm.credit.return.wizard.form</field>
        <field name="model">reza.fsm.credit.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Credit / Return" class="o_reza_credit_return_wizard">
                <header>
                    <button
                        name="action_create_credit_note"
                        string="Create &amp; Confirm Credit Note"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_add_from_catalog"
                        string="Add Products"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_open_signature"
                        string="Sign Credit Return"
                        type="object"
                        class="btn-secondary"
                        invisible="is_signed or state != 'draft'"
                    />
                    <button
                        name="action_open_customer_task"
                        string="Back to Task"
                        type="object"
                        class="btn-secondary"
                        invisible="state == 'draft'"
                    />
                    <!-- Leaves the credit without deleting anything. The rep
                         reopens it from the visit's Credit / Return button. -->
                    <button
                        name="action_cancel_credit_return"
                        string="Save &amp; Back to Task"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'draft'"
                    />
                    <!-- Drops the credit: deletes its draft credit note and
                         marks it Cancelled. The products stay in the log. -->
                    <button
                        name="action_discard_credit_return"
                        string="Cancel Credit"
                        type="object"
                        class="btn-secondary text-danger"
                        invisible="state != 'draft'"
                        confirm="Cancel this credit? Its draft credit note is deleted. The customer gets no credit."
                    />
                </header>
                <sheet>
                    <div class="alert alert-info" role="status" invisible="state != 'done'">
                        This credit note has <b>not</b> been emailed to the customer.
                        The office sends it from Accounting once the pricing has
                        been checked.
                    </div>
                    <div class="alert alert-secondary" role="status" invisible="state != 'cancel'">
                        This credit was <b>cancelled</b>. No credit note was made.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="state != 'draft' or not has_draft_credit_note">
                        This credit is saved as a <b>draft</b> credit note. It is
                        not finished. You can leave this screen and open it again
                        from the visit. Press <b>Create &amp; Confirm Credit Note</b>
                        to finish it.
                    </div>
                    <group>
                        <field name="task_id"/>
                        <field name="partner_id"/>
                        <field name="company_id"/>
                        <field name="user_id" readonly="1"/>
                        <field name="has_draft_credit_note" invisible="1"/>
                        <field name="state" invisible="1"/>
                        <field name="credit_note_id" invisible="1"/>
                        <field name="credit_note_name" readonly="1" invisible="not credit_note_name"/>
                        <field name="is_signed" invisible="1"/>
                        <field name="signed_by" readonly="1" invisible="not signature"/>
                        <field name="signed_on" readonly="1" invisible="not signature"/>
                        <field name="signature" widget="image" readonly="1" invisible="not signature"/>
                        <field name="allowed_return_location_ids" invisible="1"/>
                    </group>
                    <div class="alert alert-light" role="status" invisible="state != 'draft'">
                        Pick a return location and reason below, then press
                        <b>Fill Return Lines</b> to put them on every Credit Return
                        line at once. Credit Scrap lines are left alone.
                    </div>
                    <group string="Fill Return Lines" invisible="state != 'draft'">
                        <field name="bulk_return_location_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="bulk_credit_reason_ids" widget="many2many_tags"/>
                        <field name="bulk_note" placeholder="Optional note"/>
                        <button
                            name="action_fill_return_lines"
                            string="Fill Return Lines"
                            type="object"
                            class="btn-primary"
                            colspan="2"
                        />
                    </group>
                    <field name="line_ids" nolabel="1" readonly="state != 'draft'">
                        <list editable="bottom" create="0">
                            <field name="allowed_return_location_ids" column_invisible="True"/>
                            <field name="product_id" readonly="1"/>
                            <field name="quantity"/>
                            <field name="product_uom_id" optional="hide"/>
                            <field name="price_unit" optional="hide"/>
                            <field name="outcome"/>
                            <field
                                name="return_location_id"
                                options="{'no_create': True, 'no_open': True}"
                                required="outcome == 'credit_return'"
                                invisible="outcome != 'credit_return'"
                            />
                            <field
                                name="credit_reason_ids"
                                widget="many2many_tags"
                                required="outcome == 'credit_return'"
                            />
                            <field
                                name="scrap_reason_id"
                                required="outcome == 'credit_scrap'"
                                invisible="outcome != 'credit_scrap'"
                            />
                            <field name="note" optional="hide"/>
                            <button
                                name="action_duplicate_line"
                                type="object"
                                icon="fa-copy"
                                title="Duplicate line"
                            />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_reza_fsm_credit_return_wizard_list" model="ir.ui.view">
        <field name="name">reza.fsm.credit.return.wizard.list</field>
        <field name="model">reza.fsm.credit.return.wizard</field>
        <field name="arch" type="xml">
            <list string="Credits / Returns" decoration-info="state == 'draft'">
                <field name="create_date" string="Started"/>
                <field name="task_id"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="line_count"/>
                <field name="credit_note_name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'" decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_reza_fsm_credit_return_wizard_search" model="ir.ui.view">
        <field name="name">reza.fsm.credit.return.wizard.search</field>
        <field name="model">reza.fsm.credit.return.wizard</field>
        <field name="arch" type="xml">
            <search string="Credits / Returns">
                <field name="task_id"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="filter_unfinished" string="Unfinished" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_confirmed" string="Confirmed" domain="[('state', '=', 'done')]"/>
                <filter name="filter_cancelled" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
            </search>
        </field>
    </record>

    <record id="view_reza_fsm_credit_return_send_wizard_form" model="ir.ui.view">
        <field name="name">reza.fsm.credit.return.send.wizard.form</field>
        <field name="model">reza.fsm.credit.return.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Email Credit Note">
                <sheet>
                    <group>
                        <field name="credit_return_wizard_id" invisible="1"/>
                        <field name="partner_id"/>
                        <field name="email_to"/>
                        <field name="subject"/>
                        <field name="body_html" widget="html"/>
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_send_credit_note"
                        string="Send Credit Note"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_reza_fsm_credit_return_signature_wizard_form" model="ir.ui.view">
        <field name="name">reza.fsm.credit.return.signature.wizard.form</field>
        <field name="model">reza.fsm.credit.return.signature.wizard</field>
        <field name="arch" type="xml">
            <form string="Customer Signature">
                <sheet>
                    <group>
                        <field name="credit_return_wizard_id" invisible="1"/>
                        <field name="partner_id"/>
                        <field
                            name="signature"
                            widget="signature"
                            required="1"
                            full_name="partner_id"
                        />
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_confirm_signature"
                        string="Confirm Signature"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_reza_fsm_credit_return_wizard" model="ir.actions.act_window">
        <field name="name">Credit / Return</field>
        <field name="res_model">reza.fsm.credit.return.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
