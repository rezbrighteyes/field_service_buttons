<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_fsm_controllers" model="res.groups">
        <field name="name">FSM Controllers</field>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <!-- May post a rep's unfinished draft credit note from Accounting.
         Deliberately assigned to nobody here: add users in Settings > Users.
         Posting that way credits the customer but does not return the stock. -->
    <record id="group_post_unfinished_rep_credit" model="res.groups">
        <field name="name">Post unfinished rep credits</field>
        <field name="comment">Can post a field rep's unfinished draft credit note from Accounting. The post does not bring the stock back (no return events).</field>
    </record>

    <record id="group_liaise_field_rep" model="res.groups">
        <field name="name">Liaise Field Rep</field>
        <field name="implied_ids" eval="[
            (4, ref('industry_fsm.group_fsm_user')),
            (4, ref('sales_team.group_sale_salesman')),
            (4, ref('stock.group_stock_user')),
            (4, ref('purchase.group_purchase_user')),
            (4, ref('account.group_account_readonly'))
        ]"/>
    </record>

    <record id="rule_liaise_field_rep_customer_contacts" model="ir.rule">
        <field name="name">Contacts: Liaise Field Rep Customer Access</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(4, ref('reza_field_service_buttons.group_liaise_field_rep'))]"/>
        <field name="domain_force">['|', '|', '|', ('customer_rank', '&gt;', 0), ('parent_id.customer_rank', '&gt;', 0), ('id', '=', user.partner_id.id), ('user_ids', '!=', False)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Internal users who are NOT in FSM Controllers can only access non-FSM tasks -->
    <record id="rule_project_task_internal_non_fsm_only" model="ir.rule">
        <field name="name">Project Task: Internal Non-FSM Only</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('is_fsm', '=', False)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- FSM Controllers can access FSM tasks -->
    <record id="rule_project_task_fsm_controllers_fsm_only" model="ir.rule">
        <field name="name">Project Task: FSM Controllers FSM Access</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="groups" eval="[(4, ref('reza_field_service_buttons.group_fsm_controllers'))]"/>
        <field name="domain_force">[('is_fsm', '=', True)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_credit_return_event_rep_own" model="ir.rule">
        <field name="name">Credit Return Events: Field Service Own</field>
        <field name="model_id" ref="model_reza_fsm_credit_return_event"/>
        <field name="groups" eval="[(4, ref('industry_fsm.group_fsm_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_credit_return_event_controller_all" model="ir.rule">
        <field name="name">Credit Return Events: Controllers All</field>
        <field name="model_id" ref="model_reza_fsm_credit_return_event"/>
        <field name="groups" eval="[(4, ref('reza_field_service_buttons.group_fsm_controllers'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Credits / returns are stored records since 19.0.1.12.0 (they were
         transient). A rep sees the credits they started and the credits on
         visits assigned to them; controllers see every credit. -->
    <record id="rule_credit_return_wizard_rep_own" model="ir.rule">
        <field name="name">Credit / Return: Field Service Own</field>
        <field name="model_id" ref="model_reza_fsm_credit_return_wizard"/>
        <field name="groups" eval="[(4, ref('industry_fsm.group_fsm_user'))]"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('task_id.user_ids', 'in', [user.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_credit_return_wizard_controller_all" model="ir.rule">
        <field name="name">Credit / Return: Controllers All</field>
        <field name="model_id" ref="model_reza_fsm_credit_return_wizard"/>
        <field name="groups" eval="[(4, ref('reza_field_service_buttons.group_fsm_controllers'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_credit_return_wizard_company" model="ir.rule">
        <field name="name">Credit / Return: multi-company</field>
        <field name="model_id" ref="model_reza_fsm_credit_return_wizard"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_credit_return_wizard_line_rep_own" model="ir.rule">
        <field name="name">Credit / Return Line: Field Service Own</field>
        <field name="model_id" ref="model_reza_fsm_credit_return_wizard_line"/>
        <field name="groups" eval="[(4, ref('industry_fsm.group_fsm_user'))]"/>
        <field name="domain_force">['|', ('wizard_id.user_id', '=', user.id), ('wizard_id.task_id.user_ids', 'in', [user.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_credit_return_wizard_line_controller_all" model="ir.rule">
        <field name="name">Credit / Return Line: Controllers All</field>
        <field name="model_id" ref="model_reza_fsm_credit_return_wizard_line"/>
        <field name="groups" eval="[(4, ref('reza_field_service_buttons.group_fsm_controllers'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_credit_return_wizard_line_company" model="ir.rule">
        <field name="name">Credit / Return Line: multi-company</field>
        <field name="model_id" ref="model_reza_fsm_credit_return_wizard_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Credit / return log: append-only (the model refuses write and
         unlink outside sudo). A rep reads only the rows they wrote; FSM
         Controllers and Accounting (Billing) read every row. -->
    <record id="rule_credit_return_log_rep_own" model="ir.rule">
        <field name="name">Credit / Return Log: Field Service Own</field>
        <field name="model_id" ref="model_reza_fsm_credit_return_log"/>
        <field name="groups" eval="[(4, ref('industry_fsm.group_fsm_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_credit_return_log_controller_all" model="ir.rule">
        <field name="name">Credit / Return Log: Controllers All</field>
        <field name="model_id" ref="model_reza_fsm_credit_return_log"/>
        <field name="groups" eval="[(4, ref('reza_field_service_buttons.group_fsm_controllers'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_credit_return_log_account_all" model="ir.rule">
        <field name="name">Credit / Return Log: Accounting All</field>
        <field name="model_id" ref="model_reza_fsm_credit_return_log"/>
        <field name="groups" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_credit_return_log_company" model="ir.rule">
        <field name="name">Credit / Return Log: multi-company</field>
        <field name="model_id" ref="model_reza_fsm_credit_return_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
